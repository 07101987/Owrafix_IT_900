{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profiles for Students, Teachers, and Admins in the Owrafix system",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "authProvider": { "type": "string", "enum": ["whatsapp", "google", "demo"] },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "schoolName": { "type": "string" },
        "grade": { "type": "string" },
        "regNo": { "type": "string" },
        "profession": { "type": "string" },
        "course": { "type": "string" },
        "courseFee": { "type": "number" },
        "totalDue": { "type": "number" },
        "totalPaid": { "type": "number" },
        "balance": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "enrolmentStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Progress and gamification records for students",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "completedWeeks": { "type": "array", "items": { "type": "number" } },
        "streakDays": { "type": "number" },
        "lastActive": { "type": "string" }
      },
      "required": ["uid", "xp"]
    },
    "ClassroomSession": {
      "title": "ClassroomSession",
      "description": "Teacher active projector session and student attendance telemetry",
      "type": "object",
      "properties": {
        "teacherUid": { "type": "string" },
        "weekNumber": { "type": "number" },
        "isPaceLocked": { "type": "boolean" },
        "currentSlide": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["teacherUid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing basic identity and role (student, teacher, or admin)"
    },
    "/studentProgress/{userId}": {
      "schema": "StudentProgress",
      "description": "Gamification and course progress for a student"
    },
    "/classroomSessions/{sessionId}": {
      "schema": "ClassroomSession",
      "description": "Realtime classroom projector session managed by teachers"
    }
  }
}
