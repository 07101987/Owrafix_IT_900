# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Apps Script Web App /exec URL for the live Owrafix registration register.
# For GitHub Pages, set the same value as the repository Actions secret
# VITE_GOOGLE_REGISTRATION_API_URL.
VITE_GOOGLE_REGISTRATION_API_URL="YOUR_GOOGLE_APPS_SCRIPT_EXEC_URL"
